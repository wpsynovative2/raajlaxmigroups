# Google Apps Script web-app URL that receives form submissions (see google-apps-script/Code.gs)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Must match the SHARED_SECRET script property in Apps Script. Any long random string.
GOOGLE_SCRIPT_SECRET=change-me-to-a-long-random-string

# Google reCAPTCHA v3 keys (https://www.google.com/recaptcha/admin). Add your domain(s) and localhost.
# If the secret key is unset, the server skips the bot check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Scores run 0.0 (bot) to 1.0 (human). Submissions below this are rejected.
RECAPTCHA_MIN_SCORE=0.5
